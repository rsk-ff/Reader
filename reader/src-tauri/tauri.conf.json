{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reader",
  "version": "0.1.0",
  "identifier": "com.earendil.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Reader",
        "width": 1100,
        "height": 760,
        "minWidth": 330,
        "minHeight": 480,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
        "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://reader-file.localhost reader-file:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "lib/bin/pdfium.dll": "pdfium.dll",
      "icons/file-pdf.ico": "file-pdf.ico",
      "icons/file-markdown.ico": "file-markdown.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer"
      },
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor"
      },
      {
        "ext": ["markdown"],
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/file-association-icons.wxs"],
        "componentRefs": [
          "ReaderPdfFileAssociationIcon",
          "ReaderMarkdownFileAssociationIcon",
          "ReaderMarkdownLongFileAssociationIcon"
        ]
      }
    }
  }
}
